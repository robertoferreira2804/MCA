# ============================================================
# Program E (MCA-R): Control limits and ARL for Weibull processes.
# Applies the row-normalized transition matrix recursively without
# constructing it, using the kernel from the first row of M*.
# ============================================================
rm(list = ls())
t0 <- Sys.time()
options(digits = 6)

# ============================================================
# 1. INPUTS
# ============================================================
d <- 10                # Section IV-C, Table III (didactic example)
n <- 5                 # sample size
stable <- FALSE        # TRUE: kernel by log-space differencing (no cancellation;
# retains more kernel entries, so the runtime increases)

# in-control
lambda_0 <- 4.0        # Weibull scale
k_0      <- 5.0        # Weibull shape
Ly_0     <- 30         # Rounded from 29.5555 (Program D).
# Table IV: use Ly_0 = 29.5555 and set d to the chosen table row.

# Optional ARL1 example (Section IV-C): set d = 100000,
# Ly_0 = 29.5555 and k_1 = 5 with the inputs below.
k_1      <- NULL         # Weibull shape
lambda_1 <- 3.5        # Weibull scale (NULL to use the mean shift 'sh')
sh       <- -0.05      # relative shift in E[X], used only if lambda_1 = NULL
Ly_1     <- 25.8611    # upper bound for Y (Program_D_Ly.R, same n)

if (!is.null(k_1) && is.null(lambda_1)) {
  lambda_1 <- lambda_0 * gamma(1 + 1 / k_0) * (1 + sh) / gamma(1 + 1 / k_1)
}

# --- kernel entries k[h] = P(increment in [lo, hi]) ---
# stable = FALSE: difference of CDFs, F(hi) - F(lo)
# stable = TRUE : log-space differencing, S(lo) - S(hi) = exp(-A)(1 - exp(-(B - A))),
#                 with 1 - exp(-x) computed by expm1; avoids subtracting two
#                 values of the CDF close to one in the upper tail of X
kernel <- function(hi, lo, shape, scale, stable) {
  if (stable) {
    A <- (pmax(lo, 0) / scale)^shape
    B <- (hi / scale)^shape
    exp(-A) * (-expm1(A - B))
  } else {
    pweibull(hi, shape, scale) - pweibull(lo, shape, scale)
  }
}

# ============================================================
# 2. IN-CONTROL: distribution of Y, control limits, ARL0
# ============================================================
# --- states and midpoints ---
delta <- Ly_0 / d
mid   <- (1:d - 0.5) * delta

# --- kernel k = first row of the unnormalised transition matrix M* ---
# k[h] = F(hi) - F(lo) (see kernel()); the kernel is cut at the first exact zero after its mode
# (m = number of retained, numerically nonzero entries)
h  <- 0:(d - 1)
hi <- h * delta + 0.5 * delta
lo <- h * delta - 0.5 * delta
k  <- kernel(hi, lo, k_0, lambda_0, stable)
k[k < 0] <- 0
j0 <- which.max(k)                             # mode of the kernel
z  <- which(k[j0:d] == 0)                      # first exact zero after it
m  <- if (length(z)) j0 + z[1] - 2 else d
k  <- k[1:m]
m_0 <- m

# --- row sums of the truncated M* (row normalisation) ---
rowsum_i <- cumsum(k)[pmin(d:1, m)]
rowsum_i[rowsum_i <= 0] <- 1

# --- fY = b %*% M^n, in n steps ---
f <- c(1, rep(0, d - 1))                         # b
for (step in 1:n) {                              # f <- f %*% M
  g <- numeric(d)
  for (hh in 1:m) {                              # banded Toeplitz product
    i_max <- d - hh + 1
    if (i_max <= 0) break
    g[hh:d] <- g[hh:d] + k[hh] * f[1:i_max] / rowsum_i[1:i_max]
  }
  g[g < 0] <- 0
  f <- g / sum(g)
}
fY <- f

# --- control limits: weighted quantiles of the midpoints, snapped to a midpoint ---
FY <- cumsum(fY)
# To inspect the probabilities in Table III:
# print(data.frame(midpoint = mid, probability = fY, cumulative = FY))
q  <- c(pnorm(-3), 1 - pnorm(-3))
CL <- sapply(q, function(p) {                   # weighted quantile, linear
  l <- max(c(1, which(FY <= p)))                 # interpolation of the c.d.f.
  if (FY[l] < p && l < d) mid[l] + (mid[l + 1] - mid[l]) * (p - FY[l]) / (FY[l + 1] - FY[l]) else mid[l]
})
LCLy <- mid[which.min(abs(mid - CL[1]))]
UCLy <- mid[which.min(abs(mid - CL[2]))]

ARL0 <- 1 / sum(fY[mid <= LCLy | mid > UCLy])

# ============================================================
# 3. OUT-OF-CONTROL: ARL1 with the in-control limits
# ============================================================
if (!is.null(k_1)) {
  delta <- Ly_1 / d
  mid   <- (1:d - 0.5) * delta
  
  h  <- 0:(d - 1)
  hi <- h * delta + 0.5 * delta
  lo <- h * delta - 0.5 * delta
  k  <- kernel(hi, lo, k_1, lambda_1, stable)
  k[k < 0] <- 0
  j0 <- which.max(k)                             # mode of the kernel
  z  <- which(k[j0:d] == 0)                      # first exact zero after it
  m  <- if (length(z)) j0 + z[1] - 2 else d
  k  <- k[1:m]
  
  rowsum_i <- cumsum(k)[pmin(d:1, m)]
  rowsum_i[rowsum_i <= 0] <- 1
  
  f <- c(1, rep(0, d - 1))
  for (step in 1:n) {
    g <- numeric(d)
    for (hh in 1:m) {
      i_max <- d - hh + 1
      if (i_max <= 0) break
      g[hh:d] <- g[hh:d] + k[hh] * f[1:i_max] / rowsum_i[1:i_max]
    }
    g[g < 0] <- 0
    f <- g / sum(g)
  }
  fY1 <- f
  
  ARL1 <- 1 / sum(fY1[mid <= LCLy | mid > UCLy])
}

# ============================================================
# 4. OUTPUT
# ============================================================
cat("method = banded   stable =", stable, "  d =", d, "  n =", n, "  m =", m_0, "\n")
cat("LCLx =", LCLy / n, "  UCLx =", UCLy / n, "\n")
cat("LCLy =", LCLy, "  UCLy =", UCLy, "\n")
cat("ARL0 =", ARL0, "\n")
cat("Delta =", Ly_0 / d, "\n")
if (!is.null(k_1)) cat("ARL1 =", ARL1, "\n")
cat("Time:", as.double(Sys.time()) - as.double(t0), "s\n")
